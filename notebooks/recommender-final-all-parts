    "def p3_prepare_candidates(scores, users_idx, movies_idx, seen, truth,\n",
    "                          pop_counts, profiles, genre_unit, pool_size=100):\n",
    "    user_ids_numeric = users_idx.get_indexer(list(truth.keys()))\n",
    "    movie_numbers = movies_idx.to_numpy()\n",
    "    pop_counts = np.asarray(pop_counts).ravel()\n",
    "    contexts = {}\n",
    "    for user, user_pos in zip(truth, user_ids_numeric):\n",
    "        if user_pos >= 0:\n",
    "            row = np.array(scores[user_pos], dtype=np.float64, copy=True).ravel()\n",
    "            preference = profiles[user_pos].copy()\n",
    "        else:\n",
    "            # Cold-start user: fall back to popularity as in the Part 2 recommender.\n",
    "            row = np.asarray(pop_counts, dtype=np.float64).copy()\n",
    "            preference = np.zeros(profiles.shape[1], dtype=np.float32)\n",
    "        rated_positions = movies_idx.get_indexer(list(seen.get(user, set())))\n",
    "        rated_positions = rated_positions[rated_positions >= 0]\n",
    "        row[rated_positions] = -np.inf\n",
    "        ranked = np.lexsort((movie_numbers, -pop_counts, -row))\n",
    "        valid = ranked[np.isfinite(row[ranked])]\n",
    "        picks = valid[:pool_size]\n",
    "        if len(picks) < p3_top_k:\n",
    "            raise ValueError(f\"User {user}: fewer than {p3_top_k} unseen candidates\")\n",
    "        relevance = row[picks]\n",
    "        span = float(np.ptp(relevance))\n",
    "        normalized = ((relevance - relevance.min()) / span if span > 1e-12\n",
    "                      else np.zeros_like(relevance))\n",
    "        item_vecs = genre_unit[picks]\n",
    "        cosine = np.clip(item_vecs @ item_vecs.T, 0.0, 1.0).astype(np.float32)\n",
    "        contexts[user] = {\n",
    "            \"positions\": picks, \"relevance\": normalized,\n",
    "            \"similarity\": cosine, \"genre_profile\": preference\n",
    "        }\n",
    "    return contexts\n"
   ]
