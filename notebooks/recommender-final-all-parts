    "def p3_paired_bootstrap(new_per_user, baseline_per_user, seed=2026, n_boot=1000):\n",
    "    common = sorted(set(new_per_user) & set(baseline_per_user))\n",
    "    if not common:\n",
    "        raise ValueError(\"No users in common\")\n",
    "    delta = np.array([new_per_user[u][\"NDCG@10\"] - baseline_per_user[u][\"NDCG@10\"]\n",
    "                      for u in common], dtype=np.float64)\n",
    "    rng = np.random.default_rng(seed)\n",
    "    bootstrap_means = np.empty(n_boot, dtype=np.float64)\n",
    "    for b in range(n_boot):\n",
    "        bootstrap_means[b] = rng.choice(delta, size=len(delta), replace=True).mean()\n",
    "    lo, hi = np.quantile(bootstrap_means, [0.025, 0.975])\n",
    "    return {\"Users\":len(common), \"MeanDeltaNDCG@10\":float(delta.mean()),\n",
    "            \"CI95_Low\":float(lo), \"CI95_High\":float(hi), \"BootstrapSamples\":n_boot}\n",
    "\n",
    "p3_bootstrap = p3_paired_bootstrap(p3_test_details[p3_chosen_lambda], p3_test_details[1.0], seed=p3_seed)\n",
    "print(\"MMR minus Item-kNN baseline: paired NDCG@10 difference\")\n",
    "display(pd.DataFrame([p3_bootstrap]).round(5))"
   ]
