    "#### function to generate recommendation scores for six models:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 368,
   "id": "de560e80-070c-4ea7-a35f-45f1750f65ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "def p2_selected_scores(name, fit_data, X_train, popall, poppos, users_idx, movies_idx):\n",
    "\n",
    "    if name==\"Popular-All\":\n",
    "        #Gives every user the same scores based on the total\n",
    "        #number of ratings each movie received.\n",
    "        return np.broadcast_to(popall,(len(users_idx),len(movies_idx)))\n",
    "    if name==\"Popular-Positive\":\n",
    "        #Gives every user the same scores based on the number of\n",
    "        #positive ratings each movie received.\n",
    "        return np.broadcast_to(poppos,(len(users_idx),len(movies_idx)))\n",
    "    if name==\"Item-kNN\":\n",
    "        #Runs Part 1 Item-kNN model using its selected \n",
    "        #similarity measure and neighbourhood size.\n",
    "        return p2_item_knn_scores(X_train, best_similarity, best_k)\n",
    "        #Finds the best hyperparameters for the specified \n",
    "    #model from your Lecture 4 validation results.\n",
    "    chosen = p2_best.set_index(\"Model\").loc[name]\n",
    "    if name==\"User-kNN\":\n",
    "    #Runs User-based kNN with the selected k and shrinkage.\n",
    "        return p2_user_scores(X_train,k=int(chosen[\"k\"]),shrinkage=float(chosen[\"shrink\"]))\n",
    "    if name==\"MF-SGD\":\n",
    "    #Trains Matrix Factorization using the selected number\n",
    "    #of latent factors and regularization strength.  \n",
    "        return p2_fit_mf(fit_data,users_idx,movies_idx,factors=int(chosen[\"factors\"]),\n",
    "                         reg=float(chosen[\"reg\"]),epochs=3,seed=P2_SEED)\n",
    "    if name==\"Content\":\n",
    "    #Generates content-based scores with the selected decade weight and IDF setting\n",
    "        return p2_content_scores(X_train,movies,movies_idx,\n",
    "                                  year_weight=float(chosen[\"year_weight\"]),idf=bool(chosen[\"idf\"]))\n",
    "    #Displays an error if an unsupported model name is supplied.\n",
    "    raise ValueError(\"Unknown model \"+name)"
   ]
  },
