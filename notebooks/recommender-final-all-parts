    "def p3_user_genre_profiles(interaction_matrix, movie_genre_shares):\n",
    "    # user-genre preference\n",
    "    totals = np.asarray(interaction_matrix @ movie_genre_shares, dtype=np.float32)\n",
    "    #sum of genre for each user\n",
