   "source": [
    "def p2_user_similarity(X_train, shrinkage=0.0):#X-train is sparse matrix\n",
    "    #If shrinkage is greater than zero, this reduces similarity scores\n",
    "    binary = X_train.tocsr().astype(np.float32).copy()  # users x movies\n",
    "    binary.data[:] = 1.0  # positive interaction become 1\n",
    "    overlaps = (binary @ binary.T).tocsr()  # shared liked movies per user pair\n",
    "    norms = np.sqrt(np.asarray(binary.sum(axis=1)).ravel())  # ||X_u||\n",
    "\n",
    "    # Compute sparse cosine for every stored user pair.\n",
    "    for u in range(binary.shape[0]):\n",
    "        start, end = overlaps.indptr[u], overlaps.indptr[u + 1]\n",
    "        neighbors = overlaps.indices[start:end]\n",
    "        counts = overlaps.data[start:end].copy()\n",
    "        denom = norms[u] * norms[neighbors]\n",
    "        sims = np.divide(counts, denom, out=np.zeros_like(counts), where=denom > 0)\n",
    "        if shrinkage > 0:\n",
    "            sims *= counts / (counts + float(shrinkage))\n",
    "        overlaps.data[start:end] = sims\n",
    "\n",
    "    overlaps.setdiag(0)  # user cannot be own neighbour\n",
    "    overlaps.eliminate_zeros()\n",
    "    return overlaps"
   ]
  },
  {
