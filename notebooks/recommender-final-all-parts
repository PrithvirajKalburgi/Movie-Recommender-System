    "#### check genre diveristy higher means it recommend more diverse genres\n",
    "def p3_intralist_diversity(pool_similarity, selected_local):\n",
    "    if len(selected_local) < 2:\n",
    "        return 0.0\n",
    "    sim = pool_similarity[np.ix_(selected_local, selected_local)]\n",
    "    pair_values = sim[np.triu_indices(len(selected_local), k=1)]\n",
    "    return float(np.mean(1.0 - pair_values))"
