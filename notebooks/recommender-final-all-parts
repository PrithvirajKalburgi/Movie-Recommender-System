   "source": [
    "# Number of positive interactions for each movie\n",
    "\n",
    "item_counts = np.asarray(X.sum(axis=0)).ravel().astype(np.float32)\n",
    "item_counts\n",
    "# Number of users who liked both movies\n",
    "intersection = (X.T @ X).toarray().astype(np.float32)\n",
    "# Number of users who liked at least one\n",
    "union = (item_counts[:, None]+ item_counts[None, :]- intersection)\n",
    "# Calculate Jaccard\n",
    "jaccard_similarity = np.divide(intersection,union,out=np.zeros_like(intersection),where=union > 0)\n",
    "\n",
    "# Exclude self similarity\n",
    "np.fill_diagonal(jaccard_similarity, 0)\n",
    "\n",
    "print(\"Jaccard shape:\", jaccard_similarity.shape)"
   ]
