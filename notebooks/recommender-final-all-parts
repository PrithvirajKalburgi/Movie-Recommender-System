    "def p3_evaluate_sweep(contexts, lambdas, truth, movies_idx, genre_shares, k=10):\n",
    "\n",
    "    rows, details = [], {}\n",
    "    for lam in lambdas:\n",
    "        lam = float(lam)\n",
    "        all_precision, all_recall, all_ndcg = [], [], []\n",
    "        all_ild, all_calibration = [], []\n",
    "        exposure = np.zeros(len(movies_idx), dtype=np.int64)\n",
    "        per_user = {}\n",
    "        for user, context in contexts.items():\n",
    "            selected_local = p3_mmr_from_pool(context, lam, k=k)\n",
    "            selected_global = context[\"positions\"][selected_local]\n",
    "            recommendations = list(movies_idx[selected_global])\n",
    "            p, r, ndcg = ranking_metrics_at_k(recommendations, truth[user], k=k)\n",
    "            ild = p3_intralist_diversity(context[\"similarity\"], selected_local)\n",
    "            calibration = p3_calibration_error(\n",
    "                context[\"genre_profile\"], genre_shares[selected_global]\n",
    "            )\n",
    "            np.add.at(exposure, selected_global, 1)\n",
    "            all_precision.append(p)\n",
    "            all_recall.append(r)\n",
    "            all_ndcg.append(ndcg)\n",
    "            all_ild.append(ild)\n",
    "            if np.isfinite(calibration):\n",
    "                all_calibration.append(calibration)\n",
    "            per_user[user] = {\"NDCG@10\":float(ndcg), \"recs\":recommendations,\n",
    "                              \"ILD\":float(ild), \"Calibration\":calibration}\n",
    "        rows.append({\"Lambda\":lam, \"Users\":len(contexts),\n",
    "                     \"Precision@10\":float(np.mean(all_precision)),\n",
    "                     \"Recall@10\":float(np.mean(all_recall)),\n",
    "                     \"NDCG@10\":float(np.mean(all_ndcg)),\n",
    "                     \"IntraListDiversity\":float(np.mean(all_ild)),\n",
    "                     \"Coverage\":float(np.count_nonzero(exposure)/len(movies_idx)),\n",
    "                     \"Gini\":p3_gini(exposure),\n",
    "                     \"CalibrationError\":float(np.mean(all_calibration)) if all_calibration else np.nan,\n",
    "                     \"CalibrationUsers\":len(all_calibration)})\n",
    "        details[lam] = per_user\n",
    "        print(f\"lambda={lam:.2f} | NDCG@10={rows[-1]['NDCG@10']:.4f} | \"\n",
    "              f\"ILD={rows[-1]['IntraListDiversity']:.4f} | Gini={rows[-1]['Gini']:.4f}\")\n",
    "    result = pd.DataFrame(rows)\n",
    "    \n",
    "    return result, details\n"
   ]
  },
