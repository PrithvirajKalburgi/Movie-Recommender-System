    "def p2_user_knn_weights(similarity, k=20):##similarity matrix comes from\n",
    "    #user similarity function\n",
    "    # it Keeps at most k nonzero neighbours per row; return CSR weights.\n",
    "    if k < 1: raise ValueError(\"k must be positive\")\n",
    "    S = similarity.tocsr()\n",
    "    rows, cols, vals = [], [], []\n",
    "    for u in range(S.shape[0]):\n",
    "        start, end = S.indptr[u], S.indptr[u + 1]\n",
    "        ids = S.indices[start:end]\n",
    "        scores = S.data[start:end]\n",
    "        eligible = (ids != u) & (scores > 0)\n",
    "        ids, scores = ids[eligible], scores[eligible]\n",
    "        order = np.lexsort((ids, -scores))[:k]\n",
    "        rows.extend([u] * len(order))\n",
    "        cols.extend(ids[order].tolist())\n",
    "        vals.extend(scores[order].tolist())\n",
    "    return csr_matrix((np.asarray(vals, dtype=np.float32), (rows, cols)), shape=S.shape)#user-user weight"
   ]
  },
