     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train cut: 2000-12-02 14:52:18\n",
      "Validation cut: 2000-12-29 23:42:56.399999976\n"
     ]
    }
   ],
   "source": [
    "ratings = ratings.sort_values(\"timestamp\").reset_index(drop=True)\n",
    "train_cut = ratings[\"timestamp\"].quantile(0.80)\n",
    "val_cut = ratings[\"timestamp\"].quantile(0.90)\n",
    "\n",
    "train_cut_date = pd.to_datetime(train_cut, unit=\"s\")\n",
    "val_cut_date = pd.to_datetime(val_cut, unit=\"s\")\n",
    "\n",
    "print(\"Train cut:\", train_cut_date)\n",
    "print(\"Validation cut:\", val_cut_date)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9b326734-5682-42ac-ab84-e26ee2e4c564",
   "metadata": {},
   "source": [
    "#### Temporal split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 301,
   "id": "5606e114-a481-4431-925d-c62465e9df5e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train: (800168, 7)\n",
      "Validation: (100020, 7)\n",
      "Test: (100021, 7)\n",
      "Train %: 80.0\n",
      "Validation %: 10.0\n",
      "Test %: 10.0\n",
      "\n",
      " Time range check\n",
      "Train: 2000-04-25 23:05:32 to 2000-12-02 14:52:18\n",
      "Validation: 2000-12-02 14:52:28 to 2000-12-29 23:42:47\n",
      "Test: 2000-12-29 23:43:34 to 2003-02-28 17:49:50\n"
     ]
    }
   ],
   "source": [
    "train = ratings[\n",
    "    ratings[\"timestamp\"] <= train_cut\n",
    "].copy()\n",
    "\n",
    "validation = ratings[\n",
    "    (ratings[\"timestamp\"] > train_cut) &\n",
    "    (ratings[\"timestamp\"] <= val_cut)\n",
    "].copy()\n",
    "\n",
    "test = ratings[\n",
    "    ratings[\"timestamp\"] > val_cut\n",
    "].copy()\n",
    "\n",
    "print(\"Train:\", train.shape)\n",
    "print(\"Validation:\", validation.shape)\n",
    "print(\"Test:\", test.shape)\n",
    "total = len(ratings)\n",
    "\n",
    "print(\"Train %:\", round(len(train) / total * 100, 2))\n",
    "print(\"Validation %:\", round(len(validation) / total * 100, 2))\n",
    "print(\"Test %:\", round(len(test) / total * 100, 2))\n",
    "\n",
    "print('\\n Time range check')\n",
    "\n",
    "print(\n",
    "    \"Train:\",\n",
    "    train[\"datetime\"].min(),\n",
    "    \"to\",\n",
    "    train[\"datetime\"].max()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Validation:\",\n",
    "    validation[\"datetime\"].min(),\n",
    "    \"to\",\n",
    "    validation[\"datetime\"].max()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Test:\",\n",
    "    test[\"datetime\"].min(),\n",
    "    \"to\",\n",
    "    test[\"datetime\"].max()\n",
    ")"
   ]
