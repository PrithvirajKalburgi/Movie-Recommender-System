    "#### Matrix factorization + biases + regularization"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c1abd2eb-7b6b-4454-a1fb-0ad34f80efcf",
   "metadata": {},
   "source": [
    "##### Function is to learn hidden preferences of users and hidden characteristics of movies to predict which movies users are likely to enjoy."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 349,
   "id": "17069e11-6e34-4474-96c6-9012ca8cd16f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def p2_fit_mf(fit_ratings, users_idx, movies_idx, factors=16, reg=0.03,\n",
    "              epochs=3, lr=0.025, seed=2026):\n",
    "    rng = np.random.default_rng(seed) #Creates reproducible random numbers.\n",
    "    u = users_idx.get_indexer(fit_ratings[\"user_id\"]) #Stores matrix row positions for users.\n",
    "    i = movies_idx.get_indexer(fit_ratings[\"movie_id\"])#Stores matrix column positions for movies.\n",
    "   # Selects ratings whose users and movies exist in the model indices.\n",
    "    keep = (u>=0) & (i>=0)\n",
    "    #Removes invalid user and movie positions.\n",
    "    u, i = u[keep], i[keep]\n",
    "    #Converts observed ratings into binary training labels.\n",
    "    y = (fit_ratings.loc[keep, \"rating\"].to_numpy()>=POSITIVE_THRESOLD).astype(np.float32)\n",
    "    n_users, n_movies = len(users_idx), len(movies_idx)\n",
    "    # user latent-factor matrix using small random values.\n",
    "    P = rng.normal(0,0.07,(n_users,factors)).astype(np.float32)\n",
    "    #Initializes the movie latent-factor matrix using small random values.\n",
    "    Q = rng.normal(0,0.07,(n_movies,factors)).astype(np.float32)\n",
    "    #Initializes user and movie biases to zero.\n",
    "    bu, bi = np.zeros(n_users,dtype=np.float32), np.zeros(n_movies,dtype=np.float32)\n",
    "    #nitializes the global bias from the log-odds of positive observed ratings.\n",
    "    mu = float(np.log(np.clip(y.mean(),1e-4,1-1e-4)/(1-np.clip(y.mean(),1e-4,1-1e-4))))\n",
    "    #Creates an array of training-example positions.\n",
    "    indices = np.arange(len(u))\n",
    "    for epoch in range(epochs):\n",
    "        #Randomizes the training-example order for each epoch.\n",
    "        rng.shuffle(indices)\n",
    "        for batch in np.array_split(indices, max(1,int(np.ceil(len(u)/4096)))):\n",
    "            #\tExtracts user positions, movie positions,\n",
    "            #and binary labels for the current batch.\n",
    "            uu, ii, yy = u[batch], i[batch], y[batch]\n",
    "            pu, qi = P[uu].copy(), Q[ii].copy()\n",
    "            #Calculates the raw predicted scores and limits them to the range −20 to 20.\n",
    "            logits = np.clip(mu + bu[uu] + bi[ii] + np.sum(pu*qi,axis=1), -20,20)\n",
    "            #Calculates the prediction error used for\n",
    "            #binary cross-entropy gradient updates.\n",
    "            error = 1/(1+np.exp(-logits)) - yy  # BCE gradient w.r.t. logit\n",
    "            #Updates the user, movie latent factors using gradients and regularization.\n",
    "            #\n",
    "            np.add.at(P, uu, -lr*(error[:,None]*qi + reg*pu))\n",
    "            np.add.at(Q, ii, -lr*(error[:,None]*pu + reg*qi))\n",
    "            #Updates the user,movie biases.\n",
    "            np.add.at(bu, uu, -lr*(error + reg*bu[uu]))\n",
    "            np.add.at(bi, ii, -lr*(error + reg*bi[ii]))\n",
    "\n",
    "    #Returns the predicted raw preference-score matrix for \n",
    "    #all users and movies.\n",
    "    return (P @ Q.T + bu[:,None] + bi[None,:] + mu).astype(np.float32)"
   ]
  },
