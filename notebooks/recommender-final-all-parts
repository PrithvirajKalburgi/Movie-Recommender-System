    "def p3_genre_vectors(movies_meta, movie_index):\n",
    "    aligned = (movies_meta.drop_duplicates(\"movie_id\")\n",
    "               .set_index(\"movie_id\").reindex(movie_index))\n",
    "    genre_table = aligned[\"genres\"].fillna(\"\").str.get_dummies(sep=\"|\")\n",
    "    genre_names = genre_table.columns.tolist()\n",
    "    binary = genre_table.to_numpy(dtype=np.float32, copy=True)\n",
    "    norms = np.linalg.norm(binary, axis=1, keepdims=True)\n",
    "    unit = np.divide(binary, norms, out=np.zeros_like(binary), where=norms > 0)\n",
    "    per_movie_count = binary.sum(axis=1, keepdims=True)\n",
    "    shares = np.divide(binary, per_movie_count,\n",
    "                       out=np.zeros_like(binary), where=per_movie_count > 0)\n",
    "    return genre_names, binary, unit, shares\n",
    "\n",
