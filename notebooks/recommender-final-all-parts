   "source": [
    "##### Function is to recommend movies based on similarities between movie characteristics and the characteristics of movies a user has previously liked"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 352,
   "id": "7bab0ed7-4db1-47af-9619-f876f5abf15d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def p2_content_scores(X_train, movies_meta, movies_idx, year_weight=0.3, idf=False):\n",
    "    \n",
    "    meta = movies_meta.drop_duplicates(\"movie_id\").set_index(\"movie_id\").reindex(movies_idx)\n",
    "   #Converts movie genre labels into a numerical binary feature matrix.\n",
    "    genres = meta[\"genres\"].fillna(\"\").str.get_dummies(sep=\"|\").to_numpy(dtype=np.float32, copy=True)\n",
    "   #Extracts movie titles and replaces missing titles with empty strings\n",
    "    titles = meta[\"title\"].fillna(\"\")\n",
    "    #Extracts release years from movie titles and converts them into numbers\n",
    "    years = pd.to_numeric(titles.str.extract(r\"\\((\\d{4})\\)\")[0], errors=\"coerce\")\n",
    "   #Converts release years into decade categories such as 1990 and 2000\n",
    "   #\n",
    "    decades = ((years.fillna(1900).astype(int)//10)*10).astype(str)\n",
    "    #Creates a binary feature matrix representing each movie's release decade\n",
    "    decade_vec = pd.get_dummies(decades).to_numpy(dtype=np.float32)\n",
    "    if idf:#Checks whether genre-frequency weighting should be applied\n",
    "        #Counts how many movies belong to each genre while avoiding zero denominators\n",
    "        genre_freq = np.maximum(genres.sum(axis=0),1)\n",
    "        #Gives less common genres higher weights when IDF is enabled.\n",
    "        genres *= np.log1p(len(movies_idx)/genre_freq)[None,:]\n",
    "    F = np.concatenate([genres, year_weight*decade_vec], axis=1)\n",
    "    #Normalizes each movie's feature vector to unit length when its norm is nonzero\n",
    "    F /= np.maximum(np.linalg.norm(F,axis=1,keepdims=True),1e-12)\n",
    "    profiles = (X_train @ F).astype(np.float32)\n",
    "    profiles /= np.maximum(np.linalg.norm(profiles,axis=1,keepdims=True),1e-12)\n",
    "    #Calculates content-similarity scores between every user profile and every movie.\n",
    "    scores = profiles @ F.T\n",
    "    \n",
    "    return scores.astype(np.float32)"
   ]
  },
