    "        precisions.append(p); recalls.append(r); ndcgs.append(ndcg)\n",
    "        per_user[user] = (ndcg, recs)\n",
    "        all_recs.update(recs)\n",
    "    assert precisions, \"No eligible users\"\n",
    "    metrics = {\"Users\":len(truth), \"Precision@10\":float(np.mean(precisions)),\n",
    "               \"Recall@10\":float(np.mean(recalls)), \"NDCG@10\":float(np.mean(ndcgs)),\n",
    "               \"Coverage\":len(all_recs)/len(movies_idx)}\n",
    "    return metrics, per_user"
   ]
