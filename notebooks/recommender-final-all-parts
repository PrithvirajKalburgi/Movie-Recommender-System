    "def build_knn_weights(similarity, k):\n",
    "    n_items = similarity.shape[0]\n",
    "    if not 1 <= k < n_items:\n",
    "        raise ValueError(\"Invalid k\")\n",
    "    # Copy similarity matrix\n",
    "    sim = similarity.copy()\n",
    "    # Exclude each movie from its own neighbors\n",
    "    np.fill_diagonal(sim, -np.inf)\n",
    "\n",
    "    # Select top-k similar movie indices\n",
    "    neighbors = np.argsort(-sim, axis=1, kind=\"stable\")[:, :k]\n",
    "\n",
    "    # Get actual similarity values\n",
    "    weights = np.take_along_axis(similarity, neighbors, axis=1)\n",
    "\n",
    "    # Create sparse neighbor-weight matrix\n",
    "    W = csr_matrix((weights.ravel(),\n",
    "            (np.repeat(np.arange(n_items), k),\n",
    "                neighbors.ravel()\n",
    "            )),shape=(n_items, n_items))\n",
    "\n",
    "    W.eliminate_zeros()\n",
    "\n",
    "    return W.T.tocsr()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 322,
   "id": "6fff34e1-b554-4134-b2bb-7c7a8cc7b6fd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# User ID → matrix row\n",
    "user_to_row = {uid: i for i, uid in enumerate(user_ids)}\n",
    "\n",
    "# Popularity used for deterministic tie-breaking\n",
    "popularity_tiebreak = popular_all.reindex(movie_ids, fill_value=0).to_numpy()\n",
    "\n",
    "\n",
    "def recommend_knn(user_id, weights_T, n=10):\n",
    "    scores = np.zeros(len(movie_ids), dtype=np.float32)\n",
    "\n",
    "    # Calculate item-kNN scores\n",
    "    if user_id in user_to_row:\n",
    "        scores = (X[user_to_row[user_id]] @ weights_T).toarray().ravel()\n",
    "\n",
    "    # Remove previously rated movies\n",
    "    seen = train_seen.get(user_id, set())\n",
    "\n",
    "    seen_positions = movie_ids.get_indexer(list(seen))\n",
    "\n",
    "    seen_positions = seen_positions[seen_positions >= 0]\n",
    "\n",
    "    scores[seen_positions] = -np.inf\n",
    "\n",
    "    # Sort by score, popularity, then movie ID\n",
    "    ranked = np.lexsort((movie_ids.to_numpy(),-popularity_tiebreak,-scores))\n",
    "\n",
    "    # Select top-n valid candidates\n",
    "    top = ranked[np.isfinite(scores[ranked])][:n]\n",
    "\n",
    "    return pd.Series(scores[top],index=movie_ids[top],name=\"knn_score\")"
   ]
  },
