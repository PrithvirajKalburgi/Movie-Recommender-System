    "def p2_recommend(user_id, scores, users_idx, movies_idx, seen, popular_counts, n=10):\n",
    "    \n",
    "    user_pos = users_idx.get_indexer([user_id])[0]\n",
    "    row = scores[user_pos].copy() if user_pos >= 0 else np.zeros(len(movies_idx), dtype=np.float32)\n",
    "    row = np.asarray(row, dtype=np.float32).ravel()\n",
    "    item_positions = movies_idx.get_indexer(list(seen.get(user_id, set())))\n",
    "    row[item_positions[item_positions >= 0]] = -np.inf\n",
    "    order = np.lexsort((movies_idx.to_numpy(), -np.asarray(popular_counts), -row))\n",
    "    top = order[np.isfinite(row[order])][:n]\n",
    "    return list(movies_idx[top])"
