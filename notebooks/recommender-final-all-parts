    "def p3_mmr_from_pool(context, lam=0.75, k=10):\n",
    "    if not 0 <= lam <= 1:\n",
    "        raise ValueError(\"lambda must be between 0 and 1\")\n",
    "    relevance = context[\"relevance\"]\n",
    "    similarity = context[\"similarity\"]\n",
    "    n = len(relevance)\n",
    "    if n < k:\n",
    "        raise ValueError(\"Not enough candidates\")\n",
    "    if lam == 1.0:\n",
    "        return np.arange(k, dtype=np.int32)  # identical base ranking\n",
    "    chosen = []\n",
    "    chosen_mask = np.zeros(n, dtype=bool)\n",
    "    maximum_similarity = np.zeros(n, dtype=np.float64)\n",
    "    for step in range(k):\n",
    "        if step == 0:\n",
    "            # Without a previous choice, select the most relevant film first.\n",
    "            objective = relevance.copy()\n",
    "        else:\n",
    "            objective = lam * relevance - (1.0 - lam) * maximum_similarity\n",
    "        objective[chosen_mask] = -np.inf\n",
    "        next_local = int(np.argmax(objective))\n",
    "        chosen.append(next_local)\n",
    "        chosen_mask[next_local] = True\n",
    "        maximum_similarity = np.maximum(maximum_similarity, similarity[:, next_local])\n",
    "    return np.asarray(chosen, dtype=np.int32)\n"
   ]
