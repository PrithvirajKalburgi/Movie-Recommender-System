   "source": [
    "# Similarity between every pair of movies\n",
    "item_similarity = cosine_similarity(X.T).astype(np.float32)\n",
    "\n",
    "# Remove self-similarity\n",
    "np.fill_diagonal(item_similarity, 0)\n",
    "\n",
    "K = 20\n",
    "neighbors = np.argsort(-item_similarity,axis=1,kind=\"stable\")[:, :K]\n",
    "\n",
    "neighbor_weights = np.take_along_axis(item_similarity,neighbors,axis=1)\n",
    "# User ID to matrix row position\n",
    "user_to_row = {user_id: i for i, user_id in enumerate(user_ids)}\n",
    "\n",
    "\n",
    "# Movie popularity used to break equal scores\n",
    "popularity_tiebreak = popular_all.reindex(movie_ids, fill_value=0).to_numpy()\n",
    "\n",
    "def recommend_item_knn(user_id, n=10):\n",
    "\n",
    "    # Positive movie history of this user\n",
    "    liked = np.zeros(len(movie_ids), dtype=np.float32)\n",
    "\n",
    "    if user_id in user_to_row:\n",
    "        liked = X[user_to_row[user_id]].toarray().ravel()\n",
    "\n",
    "    # Score every candidate movie using its top-K neighbors\n",
    "    scores = (neighbor_weights * liked[neighbors]).sum(axis=1)\n",
    "\n",
    "    # Exclude all movies already rated in training\n",
    "    seen = train_seen.get(user_id, set())\n",
    "\n",
    "    seen_positions = movie_ids.get_indexer(list(seen))\n",
    "    seen_positions = seen_positions[seen_positions >= 0]\n",
    "\n",
    "    scores[seen_positions] = -np.inf\n",
    "\n",
    "    # Rank by score, then popularity, then movie ID\n",
    "    ranked_positions = np.lexsort((movie_ids.to_numpy(),-popularity_tiebreak,-scores))\n",
    "\n",
    "    top_positions = ranked_positions[:n]\n",
    "\n",
    "    return pd.Series(\n",
    "        scores[top_positions],\n",
    "        index=movie_ids[top_positions],\n",
    "        name=\"knn_score\")"
   ]
