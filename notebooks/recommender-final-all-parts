   "source": [
    "#Gini coefficient from movie recommendation counts to measure\n",
    "#how unequally movies receive exposure across the catalogue lower values indicate more equal exposure.\n",
    "def p3_gini(exposure_counts):\n",
    "    values = np.sort(np.asarray(exposure_counts, dtype=np.float64).ravel())\n",
    "    n = len(values)\n",
    "    if n == 0 or values.sum() <= 0:\n",
    "        return 0.0\n",
    "    return float((n + 1.0 - 2.0 * np.cumsum(values).sum() / values.sum()) / n)\n"
   ]
  },
