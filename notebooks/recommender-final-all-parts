   "id": "ed32a60c-8f10-406a-a602-1e2e833b1f82",
   "metadata": {},
   "outputs": [],
   "source": [
    "#how closely the genres of recommended\n",
    "#movies match a user's historical genre preferences.\n",
    "def p3_calibration_error(user_profile, recommended_genre_shares):\n",
    "    p = np.asarray(user_profile, dtype=np.float64).ravel()\n",
    "    q = np.asarray(recommended_genre_shares, dtype=np.float64).mean(axis=0)\n",
    "    if p.sum() <= 0 or q.sum() <= 0:\n",
    "        return float(\"nan\")\n",
    "    p, q = p / p.sum(), q / q.sum()\n",
    "    middle = 0.5 * (p + q)\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        kl_pm = np.where(p > 0, p * np.log(p / middle), 0.0).sum()\n",
    "        kl_qm = np.where(q > 0, q * np.log(q / middle), 0.0).sum()\n",
    "    return float(np.clip((0.5 * kl_pm + 0.5 * kl_qm) / np.log(2), 0, 1))"
   ]
  },
