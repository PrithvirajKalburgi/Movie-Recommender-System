    "def p2_item_knn_scores(X_train, similarity_name, k):#X_train is sparse matrix\n",
    "\n",
    "    # we use Part 1 build_knn_weights()\n",
    "    if similarity_name == \"Cosine\":\n",
    "        sim = cosine_similarity(X_train.T).astype(np.float32)\n",
    "    else:\n",
    "        counts = np.asarray(X_train.sum(axis=0)).ravel().astype(np.float32)\n",
    "        inter = (X_train.T @ X_train).toarray().astype(np.float32)\n",
    "        union = counts[:,None]+counts[None,:]-inter\n",
    "        sim = np.divide(inter,union,out=np.zeros_like(inter),where=union>0)\n",
    "    np.fill_diagonal(sim,0)\n",
    "    W_T = build_knn_weights(sim,k)  # Your original Part 1 function\n",
    "    return (X_train @ W_T).toarray().astype(np.float32)\n",
    "\n",
    "# Verify Part 1 model's shape and scoring on toy data.\n",
    "item_scores = p2_item_knn_scores(X, \"Cosine\", 1)\n",
